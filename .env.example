# ==========================================
# Fresher.AI Monorepo Environment Config
# ==========================================

# Gateway & Ports
PORT=5000
GATEWAY_PORT=5000
USER_SERVICE_PORT=5001
RESUME_SERVICE_PORT=5002
INTERVIEW_SERVICE_PORT=5003
FEEDBACK_SERVICE_PORT=5004
ROADMAP_SERVICE_PORT=5005
CLIENT_PORT=5173

# URLs
CLIENT_URL=http://localhost:5173
GATEWAY_URL=http://localhost:5000
USER_SERVICE_URL=http://localhost:5001
RESUME_SERVICE_URL=http://localhost:5002
INTERVIEW_SERVICE_URL=http://localhost:5003
FEEDBACK_SERVICE_URL=http://localhost:5004
ROADMAP_SERVICE_URL=http://localhost:5005

# Databases
MONGO_URI=mongodb://127.0.0.1:27017/fresher_ai
REDIS_URL=redis://127.0.0.1:6379

# AI & LLM Provider (gemini | openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Interview Configuration
INTERVIEW_COST_COINS=50
QUESTION_TIME_LIMIT_SEC=60
TOTAL_QUESTIONS=6

# Firebase Admin (Backend Gateway) - Optional for demo mode
FIREBASE_PROJECT_ID=fresher-ai-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@fresher-ai-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC5...\n-----END PRIVATE KEY-----\n"

# Firebase Client SDK (Client Web App)
VITE_FIREBASE_API_KEY=AIzaSyDemoDummyApiKeyForLocalPresentation
VITE_FIREBASE_AUTH_DOMAIN=fresher-ai-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fresher-ai-demo
VITE_FIREBASE_STORAGE_BUCKET=fresher-ai-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_API_BASE_URL=http://localhost:5000/api

